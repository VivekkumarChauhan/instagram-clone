# ==============================================================================
# LUMIGRAM BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholder values with your own keys.
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Connection (Local MongoDB or MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/instagram_clone
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/instagram_clone

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token & Session Lifespans
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d
OTP_EXPIRATION_MINUTES=10
SESSION_MAX_DAYS=30

# ==============================================================================
# CLOUDINARY MEDIA STORAGE CONFIGURATION
# Sign up at https://cloudinary.com and get these from your dashboard
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# TRANSACTIONAL EMAIL / FIREBASE / RESEND DISPATCH (HTTPS Port 443)
# Outbound SMTP (ports 25/465/587) is blocked on Render free tier.
# Use Resend API or Google Apps Script Webhook for 100% reliable HTTPS delivery.
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
GOOGLE_MAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec
FIREBASE_AUTH_CREDENTIALS=path/to/firebase-service-account.json
