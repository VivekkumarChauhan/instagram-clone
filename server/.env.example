# ==============================================================================
# LUMIGRAM BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholder values with your own keys.
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection (Local MongoDB or MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/instagram_clone
MONGODB_URI=mongodb://127.0.0.1:27017/instagram_clone

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token & Session Lifespans
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d
OTP_EXPIRATION_MINUTES=10
SESSION_MAX_DAYS=30

# ==============================================================================
# FIREBASE ADMIN SDK CONFIGURATION (Optional for Phone/Email Verification)
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# SMTP / EMAIL DISPATCH CONFIGURATION (Gmail / SendGrid / Custom SMTP)
# For Gmail: Use a 16-character Google App Password (not your personal password)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=your_email@gmail.com
